---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import CardBlog from "@components/ui/cards/CardBlog.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

const englishPosts = await getCollection("blog", ({ id }) => {
  return id.startsWith("en/");
});

const blogPosts: CollectionEntry<"blog">[] = englishPosts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<MainLayout>
    <div   data-pagefind-filter="language:english"></div>
    <div class="content py-2 px-10 mt-5 md:text-pretty">
        <img class="w-full md:w-64 mr-4 float-left" src="/photohome.jpg" alt="Dr P J Thomas">
        <div class=" text-neutral-800 dark:text-neutral-200  break-all md:break-normal">
            Dr P J Thomas was born on February 25, 1895, in Kuravilangad, Travancore. He completed his B.Litt.and D.Phil. in Economics from Oxford University, among the first Indian economists to earn a doctorate from Oxford. He was appointed Economic Adviser to the Government of India during the period 1942-1948 and was part of the Indian delegation to the 1945 San Francisco Conference leading to the creation of the UN. He also served as a Rajya Sabha MP from 1957-1962. He championed the causes of the common man and pursued philantrophic causes in his private life, for example, donating 10 acres of his property to found Avilalayam, a shelter and vocational learning centre, to support homeless women, offering residential facility with vocational training. He eventually passed away on July 26th, 1965, in Aluva, Kerala.
        </div>
    </div>

    <div class="content py-2 px-10 mt-5 text-pretty  text-neutral-800 dark:text-neutral-200 ">

    <div class="underline px-10">Education</div>

    <ul class="list-disc">
        <li> B.A. (Hons.) in History and Economics from St. Joseph’s College, Trichy (Recipient of Norton Prizeman and the Raja Sir Ramaswami Gold Medal, 1916).</li>
        <li> B.Litt. and D.Phil. in History and Economics from Balliol College, Oxford (1920–24). His B.Litt. research paper was published by P.S. King printers as “Mercantilism and East India Trade”. His D.Phil. research paper was published as “The Growth of Federal Finance in India”. </li>
    </ul>

    <div class="underline px-10">Academic Career</div>

<ul class="list-disc">
    <li>  Lecturer in Economics, Ceylon University College, Colombo (1924–27).</li>
    <li>  Professor of Economics, Madras University (1927–42).</li>
    <li>  Founding Principal, St. Thomas College, Pala (1950–52).</li>
</ul>

    <div class="underline px-10">Professional Aﬀiliations</div>
<ul class="list-disc">
    <li>  Created Economic Society in Colombo</li>
    <li>  Member, Indian Economic Association (President, 1937–38).</li>
    <li>  Member, Madras Legislative Council (1937–42).</li>
</ul>
    <div class="underline px-10">Government Service</div>
<ul class="list-disc">
    <li>  Chairman, Handloom and Mill Committee, Government of India (1942).</li>
    <li>  Economic Advisor, Department (later Ministry) of Finance, Government of India (1943-49).</li>
    <li>  Delegate to the San Francisco Conference (25 April-26 June 1945), pivotal in drafting ECOSOC, the third major organ of the United Nations.</li>
    <li>  Secretary, Cabinet Committee on Economic Aﬀairs (1947-48).</li>
    <li>  Chairman, Cottage Industries Committee (1950-51).</li>
    <li>  Member, Prohibition Committee, Planning Commission (1955).</li>
    <li>  Member, Banking Enquiry Commission, Travancore-Cochin Government (1956).</li>
</ul>

    <div class="underline px-10">Political Roles</div>
<ul class="list-disc">
    <li>  Member, Rajya Sabha (1957–62).</li>
    <li>  Member and Treasurer, Pradesh Congress Committee (PCC), Travancore-Cochin (1951–52).</li>
</ul>
    </div>

    <div class="content flex py-2 px-10 mt-5  text-neutral-800 dark:text-neutral-200">
        Click the below links to learn more
    </div>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    {/* Blog posts grid */}
    <div class="grid gap-6 lg:grid-cols-2">
      {blogPosts.map((blogEntry) => <CardBlog blogEntry={blogEntry} />)}
    </div>
  </section>

</MainLayout>
