---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";

import { Image } from 'astro:assets';
import qrcode from '/public/pjthomas-url-qr.png';

const pageTitle: string = `Contact | ${SITE.title}`;
const metaDescription =
  "Have questions or suggestions?";
const ogTitle = "Contact Us";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://pjthomas-digital.vercel.app/contact",
    url: "https://pjthomas-digital.vercel.app/contact",
    name: "Contact Us",
    description:
      "Have questions or want to discuss a project? Reach out, and let's craft the perfect solution with our tools and services.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://pjthomas-digital.vercel.app",
      name: "Dr P J Thomas Museum",
      description:
        "Dr P J Thomas digital museum",
    },
    inLanguage: "en-US",
  }}
>
    <!-- Contact Us -->
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto max-w-2xl lg:max-w-5xl">
        <div class="text-center">
          <h1
            class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
          >
              Contact
          </h1>
          <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
            {metaDescription}
          </p>
        </div>
         <div class="mt-10  text-neutral-800 dark:text-neutral-200">
             <p>
                 This website is maintained by the family of Dr P J Thomas. For any queries or new information which you can share, please contact <a href="mailto:vinodjacobmatthew@gmail.com" class="text-indigo-900 dark:text-indigo-400 underline">vinodjacobmatthew@gmail.com</a>
            </p>
            <p class = "mt-5">

            </p>The source code for the website is available at <a href="https://github.com/vinodjam/pjthomas-digital" class="text-indigo-900 dark:text-indigo-400 underline">https://github.com/vinodjam/pjthomas-digital</a></p>

            <p>
                Any media sourced from us is meant to be used only for non-commercial purposes/under Fair Use rules unless otherwise specified or permission received. External resources will follow corresponding licenses
            </p>

            <p>
                The descendants have also reached an agreement with Granthappura to digitize any material related to Dr P J Thomas. Please see their announcement of the same here <a href="https://indicarchive.org/blog/p-j-thomas-digitization-project" class="text-indigo-900 dark:text-indigo-400 underline">https://indicarchive.org/blog/p-j-thomas-digitization-project/</a>
            </p>

            <br></br>
            <figure>
            <Image class="ml-auto mr-auto"  src={qrcode} alt="QR Code" />
            <figcaption class="flex items-center justify-center">Shareable QR Code for https://pjthomas-digital.vercel.app/</figcaption>
            </figure>
         </div>
      </div>
    </section>

  <!-- <ContactSection /> -->
</MainLayout>
